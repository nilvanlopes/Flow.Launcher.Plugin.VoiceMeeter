    <RootNamespace>Flow.Launcher.Plugin.VoiceMeeter</RootNamespace>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Flow.Launcher.Plugin">
      <HintPath>C:\Users\pyu\AppData\Local\FlowLauncher\app-2.1.3\Flow.Launcher.Plugin.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="NAudio">
      <HintPath>C:\Users\pyu\AppData\Roaming\FlowLauncher\Plugins\Audio Device Selector-1.0.3\NAudio.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="NAudio.Wasapi">
      <HintPath>C:\Users\pyu\AppData\Roaming\FlowLauncher\Plugins\Audio Device Selector-1.0.3\NAudio.Wasapi.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <Target Name="CopyAudioDependencies" AfterTargets="Build">
    <ItemGroup>
      <AudioDependency Include="C:\Users\pyu\AppData\Roaming\FlowLauncher\Plugins\Audio Device Selector-1.0.3\NAudio.Core.dll" />
      <AudioDependency Include="C:\Users\pyu\AppData\Roaming\FlowLauncher\Plugins\Audio Device Selector-1.0.3\NAudio.Wasapi.dll" />
